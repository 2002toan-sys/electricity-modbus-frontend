# Copy this file to .env beside docker-compose.stack.yml.
# Set public URLs to HTTPS addresses reachable from users' browsers.
REACT_APP_API_BASE=https://your-domain.example/api
REACT_APP_SOCKET_URL=https://your-domain.example

# Backend authentication. Generate a unique JWT secret with:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
NODE_ENV=production
JWT_SECRET=
JWT_ISSUER=hotel-modbus-system
JWT_AUDIENCE=hotel-modbus-frontend
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_COOKIE_SECURE=true

# Required only until the one-time initial-admin migration has run successfully.
# Do not use a sample/default password. After successful first login, unset both values.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# Optional third-party API access key; leave empty if unused.
API_KEY=
BACKEND_DATA_DIR=/opt/hotel-modbus/backend/data
BACKEND_LOGS_DIR=/opt/hotel-modbus/backend/logs
LOG_TO_FILE=true
LOG_LEVEL=info
