# Copy to .env.stack and fill in deployment-specific values.
NODE_ENV=production
JWT_SECRET=replace-with-a-unique-secret-at-least-32-characters
API_KEY=

# Host paths on the Docker node; must be writable and persistent.
BACKEND_DATA_DIR=/home/hotel-modbus-backend-v2/data
BACKEND_LOGS_DIR=/home/hotel-modbus-backend-v2/logs

# true writes files under BACKEND_LOGS_DIR; false keeps console logging only.
LOG_TO_FILE=true
LOG_LEVEL=info

# These URLs must be reachable from users' browsers.
REACT_APP_API_BASE=http://localhost:3000/api
REACT_APP_SOCKET_URL=http://localhost:3000
